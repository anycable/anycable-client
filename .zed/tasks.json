// Static tasks configuration.
//
// Example:
[
  {
    "label": "jest $ZED_SYMBOL",
    "command": "yarn",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": [
      "jest",
       "--runInBand",
      "--testNamePattern",
      "\"$ZED_SYMBOL\"",
      "$ZED_FILE"
    ],
    "env":
    {
      "NODE_OPTIONS": "--experimental-vm-modules"
    },
    "tags": ["ts-test", "js-test"]
  }
]
